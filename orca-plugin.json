{
  "manifestVersion": 2,
  "id": "agent-profiles",
  "name": "Agent Profiles",
  "version": "2.0.9",
  "description": "Launch Orca's agents with saved profiles: model, effort, extra arguments and, for Claude, a provider such as Ollama or OpenRouter.",
  "author": { "name": "Romain Ecarnot", "url": "https://github.com/eRom" },
  "repository": "https://github.com/eRom/orca-plugin-agent-profiles",
  "license": "MIT",
  "icon": "media/icon.png",
  "cover": {
    "path": "media/cover.png",
    "alt": "The Agents panel with profiles grouped by agent, beside the command a Claude profile launches through Ollama."
  },
  "screenshots": [
    {
      "path": "media/screenshot-light.png",
      "alt": "The Agents panel in Orca's light theme: Antigravity and Claude groups, each profile with its model, effort, launch and edit buttons.",
      "caption": "Follows Orca's theme"
    },
    {
      "path": "media/screenshot-form-dark.png",
      "alt": "The dark profile form for a Claude profile: name, avatar, model glm-5.3:cloud[1m], effort Max, provider Ollama, extra arguments.",
      "caption": "One profile, every setting",
      "theme": "dark"
    },
    {
      "path": "media/screenshot-form-light.png",
      "alt": "The same profile form in the light theme.",
      "caption": "One profile, every setting",
      "theme": "light"
    }
  ],
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:launch" },
    { "kind": "storage:own" }
  ],
  "contributes": {
    "panels": [
      { "id": "agents", "title": "Agents", "icon": "bot", "entry": "src/panel.tsx", "ui": "components" }
    ],
    "commands": [
      { "id": "agentProfiles.relaunchLast", "title": "Agents: relaunch last profile", "when": "workspace" },
      { "id": "agentProfiles.favorite1", "title": "Agents: launch favorite 1" },
      { "id": "agentProfiles.favorite2", "title": "Agents: launch favorite 2" },
      { "id": "agentProfiles.favorite3", "title": "Agents: launch favorite 3" },
      { "id": "agentProfiles.favorite4", "title": "Agents: launch favorite 4" },
      { "id": "agentProfiles.favorite5", "title": "Agents: launch favorite 5" }
    ],
    "statusBarItems": [
      { "id": "favorite-1", "command": "agentProfiles.favorite1" },
      { "id": "favorite-2", "command": "agentProfiles.favorite2" },
      { "id": "favorite-3", "command": "agentProfiles.favorite3" },
      { "id": "favorite-4", "command": "agentProfiles.favorite4" },
      { "id": "favorite-5", "command": "agentProfiles.favorite5" }
    ],
    "keybindings": [
      { "command": "agentProfiles.relaunchLast", "key": "Mod+Alt+L", "when": "workspace" }
    ],
    "hooks": [
      { "event": "agent.launch.before" }
    ]
  }
}
