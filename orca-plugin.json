{
  "manifestVersion": 2,
  "id": "agent-profiles",
  "name": "Agent Profiles",
  "version": "2.0.5",
  "description": "Launch Orca's agents with saved profiles: model, effort, extra arguments and, for Claude, a provider such as Ollama or OpenRouter.",
  "author": { "name": "Romain Ecarnot", "url": "https://github.com/eRom" },
  "repository": "https://github.com/eRom/orca-plugin-agent-profiles",
  "license": "MIT",
  "icon": "media/icon.png",
  "cover": {
    "path": "media/cover.png",
    "alt": "The Agents panel with profiles grouped by agent, each showing its model, effort and provider, beside the command a Claude profile launches through Ollama."
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:launch" },
    { "kind": "storage:own" }
  ],
  "contributes": {
    "panels": [
      { "id": "agents", "title": "Agents", "icon": "bot", "entry": "src/panel.tsx", "ui": "components" }
    ],
    "commands": [
      { "id": "agentProfiles.relaunchLast", "title": "Agents : relancer le dernier profil", "when": "workspace" }
    ],
    "keybindings": [
      { "command": "agentProfiles.relaunchLast", "key": "Mod+Alt+L", "when": "workspace" }
    ],
    "hooks": [
      { "event": "agent.launch.before" }
    ]
  }
}
